# Exhibit timezone used for day keys and cleanup boundaries.
APP_TIMEZONE=America/Denver

# Required in production. Use different random values of at least 16 characters.
KIOSK_TOKEN=replace-with-a-random-kiosk-code
RESET_TOKEN=replace-with-a-different-random-reset-code

# Optional AI-written fish bios. Without this, deterministic local copy is used.
HF_TOKEN=
HF_VISION_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct

# Event capacity controls.
MAX_DAILY_SUBMISSIONS=500
MAX_DAILY_STORAGE_BYTES=262144000

# Local server only.
HOST=127.0.0.1
PORT=3000
CLEANUP_LOCAL_SUBMISSIONS=1
